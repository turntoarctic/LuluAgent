<?xml version="1.0" encoding="utf-8"?>
<!-- 求职搭子启动图标前景：白色对话气泡 + 蓝色对勾（搭子为你把关好岗位），
     右上浅蓝小气泡呼应「搭子对话」，底色为 @color/ic_launcher_background。
     构图以气泡主体几何中心对齐视口中心 (54,54)。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 右上角小气泡（浅蓝） -->
    <path
        android:fillColor="#B9C6F8"
        android:pathData="M79,30 m-5,0 a5,5 0 1,1 10,0 a5,5 0 1,1 -10,0" />

    <!-- 主对话气泡（圆角矩形 + 左下尾巴） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,37 H69 Q83,37 83,51 V61 Q83,75 69,75 H53 L39,85 V75 Q25,75 25,61 V51 Q25,37 39,37 Z" />

    <!-- 对勾（主色，圆头描边） -->
    <path
        android:pathData="M43,56 L50,63 L64,47"
        android:strokeColor="#274DEA"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
