<?xml version="1.0" encoding="utf-8"?>
<!-- 求职搭子启动图标前景：白色对话气泡 + 蓝色对勾（搭子为你把关好岗位），
     右上浅蓝小气泡呼应「搭子对话」，底色为 @color/ic_launcher_background -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 右上角小气泡（浅蓝） -->
    <path
        android:fillColor="#B9C6F8"
        android:pathData="M84,28 m-5,0 a5,5 0 1,1 10,0 a5,5 0 1,1 -10,0" />

    <!-- 主对话气泡（圆角矩形 + 左下尾巴） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,34 H74 Q88,34 88,48 V58 Q88,72 74,72 H58 L44,82 V72 Q30,72 30,58 V48 Q30,34 44,34 Z" />

    <!-- 对勾（主色，圆头描边） -->
    <path
        android:pathData="M48,53 L55,60 L69,44"
        android:strokeColor="#274DEA"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
